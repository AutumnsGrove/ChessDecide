{
  // Production config: `wrangler deploy --config wrangler.production.jsonc`.
  // Its database_id must be the Cloudflare D1 id (a UUID), never "local-dev".
  // Runbook: docs/DEPLOY.md.
  "name": "chessdecide-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "vars": { "CHESSDECIDE_MODE": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chessdecide",
      "database_id": "394e0101-b338-4bee-9375-bc9f96b5480c",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
